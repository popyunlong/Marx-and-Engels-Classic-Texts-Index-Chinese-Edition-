# Keep separate from marx-search.env. Install the DeepSeek key separately as
# root-only /etc/marx-citation-agent-deepseek.key (systemd LoadCredential).
CITATION_AGENT_TEST_MODE=off
CITATION_AGENT_QUEUE_PATH=/var/lib/marx-citation-agent/queue/queue.sqlite3
CITATION_AGENT_API_URL=https://api.deepseek.com
CITATION_AGENT_ALLOWED_HOSTS=api.deepseek.com
CITATION_AGENT_MODEL=deepseek-v4-flash
CITATION_AGENT_THINKING=enabled
CITATION_AGENT_REQUIRE_PROXY=1
HTTPS_PROXY=http://127.0.0.2:18080
