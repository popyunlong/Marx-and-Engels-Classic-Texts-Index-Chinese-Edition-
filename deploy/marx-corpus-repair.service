[Unit]
Description=Marx corpus text repair (read-only live corpus, fail-closed)
After=network-online.target marx-search.service
Wants=network-online.target
ConditionPathExists=/opt/marx-search/data/corpus.sqlite

[Service]
Type=oneshot
User=marx-repair
Group=www-data
WorkingDirectory=/opt/marx-search
EnvironmentFile=/etc/marx-search.env
EnvironmentFile=-/etc/marx-corpus-repair.env
Environment=PYTHONUTF8=1
Environment=PYTHONPATH=/opt/marx-search
Environment=MARX_APP_DIR=/opt/marx-search
Environment=MARX_CORPUS_REPAIR_ROOT=/home/data/marx-search-corpus-repair
Environment=MARX_CORPUS_REPAIR_DB=/home/data/marx-search-corpus-repair/review.sqlite3
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
UMask=0027
# Resource/provider failures are a skipped nightly run, not a failed website.
# ExecCondition stops before ExecStart on exit 1..254. Do not normalize those
# exit codes with SuccessExitStatus, or systemd will continue into ExecStart.
ExecCondition=/opt/marx-search/deploy/corpus_repair_preflight.sh
ExecStart=/opt/marx-search/.venv/bin/python /opt/marx-search/scripts/corpus_repair.py nightly --database /opt/marx-search/data/corpus.sqlite --project-root /opt/marx-search --feedback-db /var/www/.marx_search_full/feedback.sqlite3 --output-root /home/data/marx-search-corpus-repair --phase 0 --health-base http://127.0.0.1:8000 --window-start 01:00 --window-end 06:00 --timezone Asia/Shanghai --max-runtime-hours 5 --guard-poll-seconds 10 --healthy-resume-seconds 900
RuntimeMaxSec=5h5min
TimeoutStartSec=5h5min
TimeoutStopSec=30s
Restart=no

CPUAccounting=true
CPUQuota=10%
CPUWeight=1
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
IOAccounting=true
IOWeight=1
TasksMax=16

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/marx-search -/var/www/.marx_search_full/feedback.sqlite3
ReadWritePaths=/home/data/marx-search-corpus-repair
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
