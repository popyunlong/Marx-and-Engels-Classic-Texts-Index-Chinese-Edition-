# Read by the private-network deterministic administrator test worker only.
# This file must never contain a model key.
CITATION_AGENT_TEST_MODE=off
CITATION_AGENT_QUEUE_PATH=/var/lib/marx-citation-agent/queue/queue.sqlite3
CITATION_AGENT_MODEL=deepseek-v4-flash
CITATION_AGENT_MAX_RECORDS=512
CITATION_AGENT_MAX_PARAPHRASE_RECORDS=64
CITATION_AGENT_MAX_TOOL_ACTIONS=64
CITATION_AGENT_TIMEOUT_SECONDS=90
CITATION_AGENT_MAX_PARAPHRASE_TOOL_ACTIONS=64
CITATION_AGENT_PARAPHRASE_TIMEOUT_SECONDS=90

# Word/PDF exports are independent: Word remains downloadable when PDF conversion
# is unavailable or a comment anchor cannot be located uniquely.
CITATION_ASSISTANT_SOFFICE=/usr/bin/soffice
CITATION_ASSISTANT_PDF_TIMEOUT=180
