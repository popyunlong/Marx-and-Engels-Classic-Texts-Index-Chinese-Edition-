[Unit]
Description=Marx Search Journal GLM/PaddleOCR Recognition and MiMo Translation Worker
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/www/.marx_search_full/journal

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/marx-search
EnvironmentFile=/etc/marx-search.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/marx-search/.venv/bin/python /opt/marx-search/scripts/journal_alert_worker.py --stage=process
TimeoutStartSec=3300
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
