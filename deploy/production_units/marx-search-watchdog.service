[Unit]
Description=Marx Search health watchdog (restart service on hang/false-death)
After=marx-search.service
# 与被监控服务解耦：watchdog 自身失败不应影响 marx-search。

[Service]
Type=oneshot
# 需要 systemctl restart 权限，以 root 运行；脚本短命（探测+至多一次重启）。
User=root
ExecStart=/usr/local/sbin/marx-search-watchdog.sh
# 限制其自身可消耗的资源/权限面（oneshot 探测脚本不需要任何特殊能力）。
NoNewPrivileges=true
ProtectHome=true
