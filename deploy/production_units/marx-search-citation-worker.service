[Unit]
Description=Marx Search citation assistant worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/marx-search
EnvironmentFile=/etc/marx-search.env
Environment=CITATION_ASSISTANT_INLINE_WORKER=0
Environment=CITATION_ASSISTANT_SOFFICE=/usr/bin/libreoffice
Environment=PYTHONPATH=/opt/marx-search:/opt/marx-search-export-deps
ExecStart=/opt/marx-search/.venv/bin/python scripts/citation_assistant_worker.py
Restart=always
RestartSec=3
Nice=10
CPUQuota=100%
CPUWeight=10
IOWeight=10
MemoryHigh=1536M
MemoryMax=2G
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
