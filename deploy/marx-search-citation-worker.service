[Unit]
Description=Marx Search citation assistant worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/marx-search/current/app
EnvironmentFile=/etc/marx-search.env
Environment=CITATION_ASSISTANT_INLINE_WORKER=0
Environment=CITATION_ASSISTANT_SOFFICE=/usr/bin/libreoffice
Environment=PYTHONPATH=/opt/marx-search/current/app:/opt/marx-search/current/.deps:/opt/marx-search-export-deps
Environment=PYTHONPYCACHEPREFIX=/opt/marx-search/runtime-cache
Environment=MARX_RUNTIME_DATA_DIR=/opt/marx-search/data
Environment=MARX_RUNTIME_PDF_DIR=/opt/marx-search/pdfs
Environment=MARX_RUNTIME_LOG_DIR=/opt/marx-search/logs
Environment=MARX_AI_CONFIG_FILE=/opt/marx-search/config/ai.yaml
ExecStart=/opt/marx-search/runtime-python scripts/citation_assistant_worker.py
Restart=always
RestartSec=3
Nice=10
CPUQuota=100%
CPUWeight=10
IOWeight=10
MemoryHigh=1536M
MemoryMax=2G
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
