# ── Cloudflare 橙云代理（可选，见 CLOUDFLARE_CUTOVER.md）────────────────────────
# 默认配置（下方原样）走 Caddy 自动 Let's Encrypt，适用于「域名直连源站、未上 CF」。
# 加挂 Cloudflare 橙云后，需要改两处（其余不动）：
#   1) 证书：CF 终止边缘 TLS 后，Caddy 的 ACME 续期会变脆（TLS-ALPN 被 CF 拦、HTTP-01
#      易被 CF 重定向/缓存搅黄）。改用 Cloudflare「源站证书」(15 年有效)，在站点块内加：
#          tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key
#      并把 CF 控制台 SSL/TLS 模式设为 Full (strict)。显式 tls 会停用该站点的 ACME。
#   2) 日志真实 IP（可选）：应用层已优先读 CF-Connecting-IP（Caddy 默认原样透传该头给
#      上游，故应用拿到的真实 IP 始终正确，无需改 Caddy）。仅为让 Caddy *自身访问日志*
#      也记真实 IP，可在全局选项块加 trusted_proxies 指向 CF 段（IP 段以 CF 官方为准、
#      会更新）：servers { trusted_proxies static <CF-IPv4/IPv6 段...> }
# ── 源站锁定（已于 2026-07 上线，见 CLOUDFLARE_CUTOVER.md 第 7 步）───────────────
#   目标：所有 Web 访问必须经 CF；直连源站 IP（伪装域名 SNI/Host）一律 Caddy 静态 403，
#   不进 waitress；并对非 CF 来源剥除 CF-Connecting-IP 等头（防伪造真实 IP）。
#   snippet 由 deploy/update_cf_ips.sh 生成到 /etc/caddy/cf_origin_lock.caddy，
#   marx-search-cfip-sync.timer 每周同步官方 IP 段（validate 通过才 reload）。
#   启用 = 取消下方两行 import 注释；回滚 = 注释掉站点块内 import + reload caddy。
# ──────────────────────────────────────────────────────────────────────────────
# import /etc/caddy/cf_origin_lock.caddy
marx-search.example.com {
    # import cf_origin_lock
    encode gzip zstd

    respond /control* 404

    # 上 CF 后取消下一行注释、并把 CF SSL 设为 Full(strict)；同时注释掉自动 ACME 即生效。
    # tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key

    reverse_proxy 127.0.0.1:8000

    header {
        -Server
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://zpayz.cn https://*.zpayz.cn https://z-pay.cn https://*.z-pay.cn; frame-ancestors 'self'"
        Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
        }
        format json
    }
}
