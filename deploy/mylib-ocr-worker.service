[Unit]
Description=Bounded serial private library OCR worker
After=network.target

[Service]
Type=simple
User=minio-user
Group=minio-user
WorkingDirectory=/opt/mylib-ocr/current
EnvironmentFile=/etc/mylib.env
Environment=MYLIB_OCR_ROOT=/opt/mylib-ocr/shared PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mylib/venv/bin/python -m mylib_ocr.worker
Restart=on-failure
RestartSec=5
UMask=0077
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=500
KillMode=control-group
TimeoutStopSec=15
CPUWeight=20
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/mylib-ocr/shared
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
