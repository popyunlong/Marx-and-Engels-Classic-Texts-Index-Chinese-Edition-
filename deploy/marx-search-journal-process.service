[Unit]
Description=Marx Search Journal GLM/PaddleOCR Recognition and MiMo Translation Worker
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/www/.marx_search_full/journal

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/marx-search/current/app
EnvironmentFile=/etc/marx-search.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/marx-search/current/app:/opt/marx-search/current/.deps
Environment=PYTHONPYCACHEPREFIX=/opt/marx-search/runtime-cache
Environment=MARX_RUNTIME_DATA_DIR=/opt/marx-search/data
Environment=MARX_RUNTIME_PDF_DIR=/opt/marx-search/pdfs
Environment=MARX_RUNTIME_LOG_DIR=/opt/marx-search/logs
Environment=MARX_AI_CONFIG_FILE=/opt/marx-search/config/ai.yaml
ExecStart=/opt/marx-search/runtime-python /opt/marx-search/current/app/scripts/journal_alert_worker.py --stage=process
TimeoutStartSec=3300
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
