data/*
!data/corpus.sqlite.sha256
!data/dictionary.sqlite
!data/subject_index.sqlite
!data/dictionary_polish_report.json
!data/release.json
# 离线 IP 归属库：v4(11MB) 在 cloud_patch_files.txt 部署清单内，必须入库——
# 否则全新检出/CI 跑 test_deploy_manifests 的「清单文件存在」断言必红。
# v6(37MB) 与原始 json 不在清单、走仓库外部署，继续排除。
!data/geo/
data/geo/*
!data/geo/ip2region_v4.xdb
# 源书 PDF/电子书整目录不入库（体量巨大，走仓库外上传部署）
pdfs/
.deps_installed
__pycache__/
*.pyc
.venv/
.venv-*/
.pytest_cache/
build/
dist/
logs/
release/
config/keys/
*.pem
# 真实密钥配置：只跟踪 *.example，绝不提交含 api_key/密钥的实际文件
config/alipay.yaml
config/ai.yaml
config/zpay.yaml
config/*.override.yaml
# 运行期缓存 / 审计与构建生成物 / 临时草稿文件
cache/
audit_out/
*.log
tmp_*.html
toc*_out.json
toc_dump*.txt
# 配置批量修订前的本地备份（如 *.yaml.bak-batch1），保留本地不入库
config/*.bak-*
# 本地一次性探查产物
_*.json
# 毛泽东选集源 PDF（扫描版在 pdfs/ 已被忽略；文字版置于项目根目录，同样不入库）
毛泽东选集文字版/
# 本地一次性运维/诊断脚本（下划线前缀，任意扩展名）：保留本地备用，不入库
scripts/_*
# 第三方 pdf.js 阅读器库：网站用服务端页面图像渲染，未引用此库，不入库（防回流）
static/vendor/pdfjs/
# 「原文文库」自托管静态书库内容（145MB/8千+文件，纯文本）：与 PDF 同样走仓库外部署，不入 git
static_library/
# 「流式阅读」自托管静态书库内容（《文集》网页适配版，13MB/数百文件）：同样走仓库外部署，不入 git
stream_library/
# 「原文文库」本地演示截图：仅本地查看，不入库
_wenku_shots/
# 流式阅读源数据本地缓存（MEAS_zh 源 HTML），仅供重建用，不入 git
.cache/
# 本地会话/临时工作区：AI 会话临时产物、布局改版前的手工备份，均只留本地
/tmp/
/.layout_backup/
.claude/
# Codex 临时对比、发布候选和本地归档；正式源码必须移入受控目录后再提交
/.codex-*/
/.codex-*.tar.gz
# 用户来信、宣传素材及其它非程序制品统一放置于此目录
/artifacts/
# 根目录杂散 0 字节 sqlite 防再生（真实数据库在 data/ 下）
/corpus.sqlite
/dictionary.sqlite
# 本地图片素材（未被代码引用，仅留本地）
/背景图.png
