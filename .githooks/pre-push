#!/bin/sh
# Local pre-push gate. Enable once with: git config core.hooksPath .githooks
set -eu

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
    echo "[pre-push] SKIP_PREPUSH=1: gate explicitly bypassed."
    exit 0
fi

if [ -n "${PYTHON:-}" ]; then
    run_python() { "$PYTHON" "$@"; }
elif command -v python3.10 >/dev/null 2>&1; then
    run_python() { python3.10 "$@"; }
elif command -v py >/dev/null 2>&1 && py -3.10 -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 10))' >/dev/null 2>&1; then
    run_python() { py -3.10 "$@"; }
else
    echo "[pre-push] Python 3.10 is required for main/production gates." >&2
    exit 1
fi
branch="$(git branch --show-current)"

echo "[pre-push] 1/4 reject generated source copies ..."
if git ls-files | grep -Eq '(^|/)(artifacts|release|releases|build|dist|\.security-work)/|static/vendor/pdfjs'; then
    echo "[pre-push] rejected: generated or duplicated source is tracked." >&2
    exit 1
fi

echo "[pre-push] 2/4 compile tracked Python and run deterministic gates ..."
git ls-files '*.py' | while IFS= read -r source_file; do
    run_python -m py_compile "$source_file"
done
run_python -m pytest tests/test_deploy_manifests.py tests/test_release_metadata.py -q

echo "[pre-push] 3/4 run integration tests when advancing main or production ..."
case "$branch" in
    main|production)
        run_python -m pytest tests/ -q
        ;;
    *)
        echo "[pre-push] feature branch: full integration gate deferred to main."
        ;;
esac

echo "[pre-push] 4/4 run deployment smoke ..."
run_python scripts/deployment_smoke.py --mode server

echo "[pre-push] all applicable gates passed."
