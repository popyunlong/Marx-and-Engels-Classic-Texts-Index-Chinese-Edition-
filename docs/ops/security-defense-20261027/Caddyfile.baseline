import /etc/caddy/cf_origin_lock.caddy
mazhuzuojiansuo.com {
import cf_origin_lock
	# SSE must not be compressed/buffered: several mainland routes were
	# dropping AI streams after only the initial progress event.
	@compressible not path /api/ai/search-chat /api/search/associative /api/ai/pdf-chat-stream
	encode @compressible gzip zstd

	respond /control* 404

	# Quick chat is converted to heartbeat-padded JSON by a tiny local bridge.
	# This avoids fragile browser/edge SSE connections without touching the main app.
	@ai_quick path /api/ai/search-chat
	reverse_proxy @ai_quick 127.0.0.1:8011 {
		flush_interval -1
	}

	@ai_stream path /api/search/associative /api/ai/pdf-chat-stream
	reverse_proxy @ai_stream 127.0.0.1:8000 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:8000

	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://zpayz.cn https://*.zpayz.cn https://z-pay.cn https://*.z-pay.cn; frame-ancestors 'self'"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
	}

	log
}
